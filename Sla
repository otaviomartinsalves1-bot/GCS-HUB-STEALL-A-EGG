-- ===== TWEEN DE ANIMAÇÃO =====
local function animateColor(obj, targetColor, duration)
    local tween = TweenService:Create(obj, TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quad), { BackgroundColor3 = targetColor })
    tween:Play()
end

local function animateStrokeColor(obj, targetColor, duration)
    local tween = TweenService:Create(obj, TweenInfo.new(duration or 0.3, Enum.EasingStyle.Quad), { Color = targetColor })
    tween:Play()
end

-- ===== LÓGICA DE VALIDAÇÃO =====
local KEY_CORRETA = "777"

validateBtn.MouseButton1Click:Connect(function()
    local enteredKey = keyBox.Text

    if enteredKey == KEY_CORRETA then
        -- SUCESSO: Verde
        statusLabel.Text = "Key correta! Carregando script..."
        statusLabel.TextColor3 = Color3.fromRGB(80, 255, 120)

        -- Animação para verde
        animateColor(keyBox, Color3.fromRGB(20, 80, 40), 0.4)
        animateStrokeColor(keyStroke, Color3.fromRGB(80, 255, 120), 0.4)
        animateColor(validateBtn, Color3.fromRGB(40, 180, 80), 0.4)
        animateStrokeColor(btnStroke, Color3.fromRGB(80, 255, 120), 0.4)

        -- Espera um pouco e executa o script
        task.wait(1.2)

        -- Fecha o painel
        screenGui:Destroy()

        -- Executa o script que você enviou
        loadstring(game:HttpGet("https://pastefy.app/Gw4ebySs/raw"))()

    else
        -- ERRO: Vermelho
        statusLabel.Text = "Key incorreta! Tente novamente."
        statusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

        -- Animação para vermelho
        animateColor(keyBox, Color3.fromRGB(100, 20, 20), 0.4)
        animateStrokeColor(keyStroke, Color3.fromRGB(255, 80, 80), 0.4)
        animateColor(validateBtn, Color3.fromRGB(180, 40, 40), 0.4)
        animateStrokeColor(btnStroke, Color3.fromRGB(255, 80, 80), 0.4)

        -- Volta à cor original depois de 1.5 segundos
        task.wait(1.5)
        animateColor(keyBox, Color3.fromRGB(30, 15, 45), 0.5)
        animateStrokeColor(keyStroke, Color3.fromRGB(100, 70, 140), 0.5)
        animateColor(validateBtn, Color3.fromRGB(120, 80, 200), 0.5)
        animateStrokeColor(btnStroke, Color3.fromRGB(180, 140, 240), 0.5)

        -- Limpa o campo
        keyBox.Text = ""
    end
end)

